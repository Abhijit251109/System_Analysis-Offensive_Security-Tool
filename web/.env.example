# Leave empty for the recommended single-service Render deployment.
# The React dashboard will call the FastAPI backend through the same origin:
#   /api/health, /api/status, /api/test/stream, ...
VITE_API_BASE_URL=

# Only set this when the React dashboard is hosted separately from FastAPI.
# Example:
# VITE_API_BASE_URL=https://your-api.example.com
